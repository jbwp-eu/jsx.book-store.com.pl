[Unit]
Description=jsx.book-store.com.pl Node app (OVH)
After=network.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/var/www/jsx-book-store/current
Environment=NODE_ENV=production
EnvironmentFile=/var/www/jsx-book-store/shared/.env.production
ExecStart=/usr/bin/node backend/server.js
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
