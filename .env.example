NODE_ENV=development
PORT=3002

DB_NAME=bookstore
DB_USER=
DB_PASSWORD=

PAGINATION_LIMIT=3

# Generate with: openssl rand -hex 32
# Do not commit the real value. Replace this placeholder — the app will refuse to start
# if JWT_SECRET is missing, shorter than 32 characters, or this example string.
JWT_SECRET=change-me

VAT=0
ADMIN_PASSWORD=change-me

STRIPE_SECRET_KEY_TEST_MODE=
STRIPE_WEBHOOK_SECRET_TEST_MODE=

PAYPAL_CLIENT_ID=
PAYPAL_APP_SECRET=
PAYPAL_API_URL_TOKEN=https://api-m.sandbox.paypal.com/v1/oauth2/token
PAYPAL_API_URL_ORDER=https://api-m.sandbox.paypal.com/v2/checkout/orders

SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
DOMAIN=

ADDRESS=
